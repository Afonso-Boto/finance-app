# Dependencies (no leading slash: matches node_modules in every workspace package)
node_modules/
.pnpm-store/

# This repo uses pnpm only; never commit other lockfiles
package-lock.json
yarn.lock

# Build and test output
dist/
build/
coverage/
*.tsbuildinfo

# AWS CDK synth output (keep cdk.context.json committed: it makes synth deterministic)
cdk.out/

# Environment and secrets (commit a .env.example if one is needed)
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Temporary files
tmp/

# Local frontend config pointing at a deployed environment (see README)
packages/web/public/config.json
